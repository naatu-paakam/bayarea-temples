# Copy to .env.local (gitignored — never commit real values).
# In production, set these in the Netlify dashboard: Site config → Environment variables.
# These are used ONLY by netlify/functions/search-classify.js (server-side, never exposed to browser).

# ── Option A: Vertex AI (same credentials as keep-plants-live) ──────────────
# Prod: full JSON content as a string
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local dev: path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=

VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-east5

# ── Option B: Direct Anthropic API ──────────────────────────────────────────
# Use this if you don't have Vertex AI set up
ANTHROPIC_API_KEY=
